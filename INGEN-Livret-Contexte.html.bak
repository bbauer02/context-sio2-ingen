<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>InGen — Livret de contexte</title>
<style>
  /* ---------- Jetons : palette claire ---------- */
  :root {
    --ground:        #F7F4EE;
    --surface:       #FFFFFF;
    --sunken:        #F0EADE;
    --ink:           #1C1913;
    --ink-muted:     #5E5647;
    --ink-faint:     #8A8171;
    --rule:          #E2DACA;
    --rule-strong:   #C4B89F;
    --accent:        #8A5407;
    --accent-soft:   #F7EBD6;
    --signal:        #A32A1E;
    --signal-soft:   #FAE5E1;
    --code-bg:       #F3EEE4;
    --code-ink:      #241F16;
    --shadow:        0 1px 2px rgba(28,25,19,.05), 0 8px 24px -16px rgba(28,25,19,.3);

    --f-display: Constantia, "Sitka Text", Cambria, "Hoefler Text", Georgia, serif;
    --f-body: Corbel, "Segoe UI", "Helvetica Neue", system-ui, sans-serif;
    --f-mono: "Cascadia Mono", Consolas, "SF Mono", ui-monospace, "Liberation Mono", monospace;

    --measure: 68ch;
    --plate: 62rem;
  }

  /* ---------- Jetons : palette sombre (OS non explicité) ---------- */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground:      #131109;
      --surface:     #1C1911;
      --sunken:      #262218;
      --ink:         #EFEADD;
      --ink-muted:   #ADA290;
      --ink-faint:   #8B8171;
      --rule:        #302B20;
      --rule-strong: #4A4232;
      --accent:      #E4A84F;
      --accent-soft: #2E2210;
      --signal:      #F0907E;
      --signal-soft: #331A14;
      --code-bg:     #16130C;
      --code-ink:    #E3DCCC;
      --shadow:      0 1px 2px rgba(0,0,0,.45), 0 10px 28px -18px rgba(0,0,0,.85);
    }
  }
  /* ---------- Jetons : palette sombre (choix explicite) ---------- */
  :root[data-theme="dark"] {
    --ground:      #131109;
    --surface:     #1C1911;
    --sunken:      #262218;
    --ink:         #EFEADD;
    --ink-muted:   #ADA290;
    --ink-faint:   #8B8171;
    --rule:        #302B20;
    --rule-strong: #4A4232;
    --accent:      #E4A84F;
    --accent-soft: #2E2210;
    --signal:      #F0907E;
    --signal-soft: #331A14;
    --code-bg:     #16130C;
    --code-ink:    #E3DCCC;
    --shadow:      0 1px 2px rgba(0,0,0,.45), 0 10px 28px -18px rgba(0,0,0,.85);
  }
  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: var(--f-body);
    font-size: 17px;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
  }

  .shell { max-width: 84rem; margin: 0 auto; padding: 0 1.5rem 5rem; }

  /* ---------- Bandeau ---------- */
  .masthead {
    border-bottom: 2px solid var(--ink);
    padding: 2.75rem 0 1.5rem;
    margin-bottom: 2.5rem;
  }
  .eyebrow {
    font-size: .75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin: 0 0 .85rem;
  }
  .masthead h1 {
    font-family: var(--f-display);
    font-size: clamp(2.1rem, 5vw, 3.1rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -.015em;
    text-wrap: balance;
    margin: 0 0 .6rem;
  }
  .masthead .standfirst {
    max-width: var(--measure);
    color: var(--ink-muted);
    font-size: 1.06rem;
    margin: 0 0 1.75rem;
  }
  .masthead-meta {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem 2.25rem;
    font-size: .82rem;
    color: var(--ink-faint);
    border-top: 1px solid var(--rule);
    padding-top: 1rem;
  }
  .masthead-meta b { color: var(--ink-muted); font-weight: 600; }

  /* ---------- Grille générale ---------- */
  .layout { display: block; }
  @media (min-width: 1080px) {
    .layout {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }
  }

  /* ---------- Sommaire ---------- */
  .toc { display: none; }
  @media (min-width: 1080px) {
    .toc {
      display: block;
      position: sticky;
      top: 1.75rem;
      font-size: .85rem;
      border-left: 1px solid var(--rule);
      padding-left: 1.1rem;
      max-height: calc(100vh - 3.5rem);
      overflow-y: auto;
    }
  }
  .toc h2 {
    font-size: .72rem;
    letter-spacing: .13em;
    text-transform: uppercase;
    color: var(--ink-faint);
    font-weight: 700;
    margin: 0 0 .9rem;
    font-family: var(--f-body);
  }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .55rem; }
  .toc ol ol { margin: .45rem 0 .3rem .1rem; padding-left: .85rem; border-left: 1px solid var(--rule); gap: .35rem; }
  .toc a { color: var(--ink-muted); text-decoration: none; display: block; }
  .toc a:hover, .toc a:focus-visible { color: var(--accent); }
  .toc .toc-num {
    font-family: var(--f-mono);
    font-size: .74rem;
    color: var(--ink-faint);
    margin-right: .45rem;
  }
  .toc ol ol a { font-size: .8rem; }

  /* ---------- Flux principal ---------- */
  main { min-width: 0; }
  section { scroll-margin-top: 1.5rem; }
  section + section { margin-top: 4.25rem; }

  .sec-head { border-top: 2px solid var(--ink); padding-top: 1.1rem; margin-bottom: 1.75rem; }
  .sec-head .src {
    font-family: var(--f-mono);
    font-size: .74rem;
    letter-spacing: .04em;
    color: var(--accent);
    text-transform: uppercase;
    display: block;
    margin-bottom: .5rem;
  }
  h2.sec-title {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -.01em;
    text-wrap: balance;
    margin: 0;
  }
  .sec-head p { max-width: var(--measure); color: var(--ink-muted); margin: .7rem 0 0; font-size: .96rem; }

  h3 {
    font-family: var(--f-display);
    font-size: 1.24rem;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
    margin: 2.5rem 0 .8rem;
  }
  h4 {
    font-family: var(--f-body);
    font-size: .78rem;
    letter-spacing: .11em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink-faint);
    margin: 2rem 0 .7rem;
  }
  p, ul, ol { max-width: var(--measure); }
  p { margin: 0 0 1.05rem; }
  ul, ol { margin: 0 0 1.15rem; padding-left: 1.15rem; }
  li { margin-bottom: .4rem; }
  li::marker { color: var(--accent); }
  strong { font-weight: 700; }
  a { color: var(--accent); }
  abbr { text-decoration: none; border-bottom: 1px dotted var(--rule-strong); cursor: help; }

  .lede { font-size: 1.06rem; color: var(--ink-muted); }

  /* ---------- Planches larges ---------- */
  .plate { max-width: var(--plate); margin: 1.6rem 0 2rem; }

  /* ---------- Tableaux ---------- */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  table { border-collapse: collapse; width: 100%; font-size: .88rem; }
  caption {
    caption-side: top;
    text-align: left;
    font-size: .78rem;
    letter-spacing: .09em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink-faint);
    padding: 0 0 .6rem;
  }
  th, td { padding: .58rem .8rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--rule); }
  thead th {
    background: var(--sunken);
    font-size: .74rem;
    letter-spacing: .07em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  tbody tr:last-child td { border-bottom: 0; }
  td.num, th.num, .tnum { font-variant-numeric: tabular-nums; }
  td.mono, .mono { font-family: var(--f-mono); font-size: .82rem; }
  .row-head { font-weight: 700; white-space: nowrap; }

  .yes { color: var(--accent); font-weight: 700; }
  .no  { color: var(--signal); font-weight: 700; }
  .part { color: var(--ink-muted); font-weight: 700; }

  /* ---------- Blocs de configuration ---------- */
  .config { margin: 1.4rem 0 2rem; max-width: var(--plate); }
  .config-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .6rem 1rem;
    border: 1px solid var(--rule);
    border-bottom: 0;
    background: var(--sunken);
    padding: .55rem .9rem;
    border-radius: 3px 3px 0 0;
  }
  .config-head .name { font-family: var(--f-mono); font-weight: 700; font-size: .88rem; }
  .config-head .kind { font-size: .78rem; color: var(--ink-muted); }
  pre {
    margin: 0;
    padding: 1rem 1.1rem;
    background: var(--code-bg);
    color: var(--code-ink);
    border: 1px solid var(--rule);
    border-radius: 0 0 3px 3px;
    overflow-x: auto;
    font-family: var(--f-mono);
    font-size: .795rem;
    line-height: 1.62;
    tab-size: 2;
  }
  code { font-family: var(--f-mono); font-size: .88em; }
  p code, li code, td code, dd code {
    background: var(--sunken);
    padding: .08em .32em;
    border-radius: 2px;
    color: var(--ink);
  }
  pre .c { color: var(--ink-faint); font-style: italic; }
  pre .k { color: var(--accent); font-weight: 700; }

  /* ---------- Encadrés ---------- */
  .note {
    max-width: var(--plate);
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    padding: .95rem 1.1rem;
    margin: 1.5rem 0;
    border-radius: 0 3px 3px 0;
    font-size: .93rem;
  }
  .note.warn { border-left-color: var(--signal); background: var(--signal-soft); }
  .note > :last-child { margin-bottom: 0; }
  .note p, .note ul, .note ol { max-width: none; }
  .note .label {
    display: block;
    font-size: .72rem;
    letter-spacing: .11em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: .4rem;
  }
  .note.warn .label { color: var(--signal); }

  /* ---------- Figures ---------- */
  figure { margin: 1.8rem 0 2.25rem; max-width: var(--plate); }
  .fig-frame {
    border: 1px solid var(--rule);
    background: var(--surface);
    border-radius: 3px;
    padding: 1.25rem;
    overflow-x: auto;
    box-shadow: var(--shadow);
  }
  figure svg { display: block; width: 100%; height: auto; min-width: 30rem; color: var(--ink); }
  figcaption {
    font-size: .84rem;
    color: var(--ink-muted);
    margin-top: .7rem;
    max-width: var(--measure);
  }
  .svg-box     { fill: var(--surface); stroke: var(--rule-strong); stroke-width: 1.25; }
  .svg-box-key { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .svg-box-x   { fill: var(--signal-soft); stroke: var(--signal); stroke-width: 1.5; }
  .svg-link    { stroke: var(--rule-strong); stroke-width: 1.5; fill: none; }
  .svg-link-2  { stroke: var(--rule-strong); stroke-width: 2.25; fill: none; }
  .svg-link-x  { stroke: var(--signal); stroke-width: 2.25; fill: none; }
  .svg-flow    { stroke: var(--accent); stroke-width: 1.75; fill: none; }
  .svg-blocked { stroke: var(--signal); stroke-width: 1.75; fill: none; stroke-dasharray: 5 4; }
  .svg-dash    { stroke: var(--rule-strong); stroke-width: 1.75; fill: none; stroke-dasharray: 6 5; }
  .svg-t   { font-family: var(--f-body); font-size: 13px; font-weight: 700; fill: var(--ink); }
  .svg-s   { font-family: var(--f-body); font-size: 11px; fill: var(--ink-muted); }
  .svg-e   { font-family: var(--f-mono); font-size: 10.5px; fill: var(--ink-faint); }
  .svg-e-k { font-family: var(--f-mono); font-size: 10.5px; fill: var(--accent); }
  .svg-e-x { font-family: var(--f-mono); font-size: 10.5px; fill: var(--signal); }
  .svg-chip    { fill: var(--ink); }
  .svg-chip-x  { fill: var(--signal); }
  .svg-chip-t  { font-family: var(--f-mono); font-size: 12.5px; font-weight: 700; fill: var(--ground); }
  .svg-rail    { fill: var(--rule-strong); }
  .svg-node    { fill: var(--surface); stroke: var(--rule-strong); stroke-width: 2; }
  .svg-node-x  { fill: var(--signal); stroke: var(--signal); stroke-width: 2; }
  .svg-node-t  { font-family: var(--f-mono); font-size: 13px; font-weight: 700; fill: var(--ink); }
  .svg-node-xt { font-family: var(--f-mono); font-size: 13px; font-weight: 700; fill: var(--surface); }
  .svg-floor   { fill: var(--surface); stroke: var(--rule); stroke-width: 1.25; }
  .svg-floor-k { fill: var(--accent-soft); stroke: var(--accent); stroke-width: 1.5; }
  .svg-pill    { fill: var(--sunken); stroke: var(--rule-strong); stroke-width: 1; }
  .svg-pill-k  { fill: var(--accent); stroke: none; }
  .svg-pill-t  { font-family: var(--f-body); font-size: 12.5px; font-weight: 600; fill: var(--ink); }
  .svg-pill-kt { font-family: var(--f-body); font-size: 12.5px; font-weight: 700; fill: var(--ground); }
  .svg-rack    { fill: var(--sunken); stroke: var(--rule-strong); stroke-width: 1.25; }
  .svg-rack-u  { fill: var(--rule-strong); }

  /* ---------- Définitions ---------- */
  .deflist { max-width: var(--plate); margin: 1.3rem 0 1.9rem; }
  .deflist dt {
    font-weight: 700;
    font-size: .92rem;
    border-top: 1px solid var(--rule);
    padding-top: .7rem;
    margin-top: .7rem;
  }
  .deflist dt:first-child { border-top: 0; margin-top: 0; padding-top: 0; }
  .deflist dd { margin: .2rem 0 0; color: var(--ink-muted); font-size: .92rem; }

  /* ---------- Chiffres clés ---------- */
  .figures {
    display: grid;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 3px;
    max-width: var(--plate);
    margin: 1.5rem 0 2rem;
    overflow: hidden;
  }
  @media (min-width: 620px) { .figures { grid-template-columns: repeat(4, 1fr); } }
  .kpi { background: var(--surface); padding: 1rem 1.1rem; }
  .kpi b {
    display: block;
    font-family: var(--f-display);
    font-size: 1.75rem;
    line-height: 1.05;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .kpi span { display: block; font-size: .82rem; color: var(--ink-muted); margin-top: .25rem; }

  /* ---------- Cartes de sites ---------- */
  .cards { display: grid; gap: 1.25rem; max-width: var(--plate); margin: 1.5rem 0 2rem; }
  @media (min-width: 780px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .card {
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 0 3px 3px;
    padding: 1.05rem 1.15rem 1.2rem;
    box-shadow: var(--shadow);
  }
  .card h4 { margin: 0 0 .1rem; color: var(--accent); letter-spacing: .1em; }
  .card b.card-name { display: block; font-family: var(--f-display); font-size: 1.16rem; margin-bottom: .5rem; }
  .card p { max-width: none; font-size: .89rem; margin: 0 0 .6rem; }
  .card dl { margin: 0; font-size: .82rem; }
  .card dt { color: var(--ink-faint); text-transform: uppercase; letter-spacing: .07em; font-size: .68rem; font-weight: 700; margin-top: .5rem; }
  .card dd { margin: 0; color: var(--ink-muted); }

  /* ---------- Fiches épreuves ---------- */
  .exams { display: grid; gap: 1.25rem; max-width: var(--plate); margin: 1.5rem 0 0; }
  @media (min-width: 760px) { .exams { grid-template-columns: 1fr 1fr; } }
  .exam {
    border: 1px solid var(--rule);
    border-top: 3px solid var(--accent);
    background: var(--surface);
    border-radius: 0 0 3px 3px;
    padding: 1.15rem 1.25rem 1.35rem;
    box-shadow: var(--shadow);
  }
  .exam h3 { margin: 0 0 .15rem; font-size: 1.3rem; }
  .exam .coef { font-size: .78rem; color: var(--ink-faint); font-family: var(--f-mono); display: block; margin-bottom: .9rem; }
  .exam h4 { margin: 1.15rem 0 .5rem; }
  .exam ul, .exam p, .exam ol { max-width: none; font-size: .92rem; }
  .exam ul { padding-left: 1.05rem; }

  /* ---------- Fiche de référence ---------- */
  .fiche { display: grid; gap: 1rem; max-width: var(--plate); margin: 1.5rem 0 0; }
  @media (min-width: 820px) { .fiche { grid-template-columns: 1fr 1fr; } }
  .fiche .blk {
    border: 1px solid var(--rule);
    border-top: 2px solid var(--accent);
    background: var(--surface);
    border-radius: 0 0 3px 3px;
    padding: .75rem .85rem .85rem;
    overflow-x: auto;
  }
  .fiche .wide { grid-column: 1 / -1; }
  .fiche h4 {
    margin: 0 0 .55rem;
    color: var(--accent);
    font-size: .72rem;
    letter-spacing: .1em;
  }
  .fiche table { font-size: .76rem; }
  .fiche th, .fiche td { padding: .26rem .4rem; }
  .fiche thead th { font-size: .66rem; letter-spacing: .05em; }
  .fiche .mono, .fiche td.mono { font-size: .74rem; }
  .fiche p { font-size: .78rem; margin: .5rem 0 0; color: var(--ink-muted); max-width: none; }

  /* ---------- Étapes numérotées ---------- */
  .steps { list-style: none; padding: 0; counter-reset: step; max-width: var(--plate); }
  .steps li {
    counter-increment: step;
    padding-left: 2.1rem;
    position: relative;
    margin-bottom: .6rem;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: .05em;
    width: 1.5rem;
    height: 1.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ground);
    font-family: var(--f-mono);
    font-size: .72rem;
    font-weight: 700;
  }

  footer.colophon {
    margin-top: 4.5rem;
    border-top: 2px solid var(--ink);
    padding-top: 1.2rem;
    font-size: .82rem;
    color: var(--ink-faint);
    max-width: var(--plate);
  }
  footer.colophon p { max-width: none; }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }

  /* ---------- Impression ---------- */
  @media print {
    :root {
      --ground: #fff; --surface: #fff; --sunken: #f2f0ea; --ink: #000;
      --ink-muted: #333; --ink-faint: #555; --rule: #bbb; --rule-strong: #888;
      --accent: #6B3F04; --accent-soft: #f7f0e4; --signal: #8B231A; --signal-soft: #faece9;
      --code-bg: #f6f6f6; --code-ink: #111; --shadow: none;
    }
    body { font-size: 10.5pt; }
    .toc { display: none; }
    .layout { display: block; }
    .shell { max-width: none; padding: 0; }
    section { break-inside: auto; }
    .sec-head, h3, h4 { break-after: avoid; }
    figure, .table-wrap, .note, .card, .exam, .config, .figures { break-inside: avoid; }
    a { color: inherit; text-decoration: none; }
    #fiche { break-before: page; }
    .fiche { grid-template-columns: 1fr 1fr; gap: .6rem; }
    .fiche .blk { break-inside: avoid; box-shadow: none; }
    .fiche table { font-size: 7.2pt; }
    .fiche th, .fiche td { padding: .12rem .3rem; }
  }
</style>
</head>
<body>

<div class="shell">

  <header class="masthead">
    <p class="eyebrow">BTS SIO · Parcours SISR · Deuxième année</p>
    <h1>International Genetic Technologies</h1>
    <p class="standfirst">
      Le contexte de référence sur lequel s’appuient tous les projets de l’année : l’organisation
      d’InGen, son système d’information, l’architecture réseau d’Isla Nublar, les configurations
      initiales des matériels et l’état de la sécurité du site.
    </p>
    <div class="masthead-meta">
      <span><b>Siège</b> Palo Alto, Californie</span>
      <span><b>Sites</b> Isla Nublar · Isla Sorna</span>
      <span><b>Entités</b> InGen · Nublar Leisure S.A. · NL Europe</span>
      <span><b>Enjeu</b> menace interne, externe et conformité RGPD</span>
      <span><b>Épreuves visées</b> E4 et E5 en CCF</span>
    </div>
  </header>

  <div class="layout">

    <nav class="toc" aria-label="Sommaire">
      <h2>Sommaire</h2>
      <ol>
        <li>
          <a href="#entreprise"><span class="toc-num">01</span>L’entreprise</a>
          <ol>
            <li><a href="#fondation">Fondation et vision</a></li>
            <li><a href="#methode">La méthode scientifique</a></li>
