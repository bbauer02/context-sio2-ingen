              <rect class="svg-rack-u" x="73" y="426" width="26" height="8"/>
              <rect class="svg-rack-u" x="73" y="438" width="26" height="8"/>
              <rect class="svg-rack-u" x="73" y="450" width="26" height="8"/>
              <rect class="svg-chip" x="118" y="420" width="94" height="32" rx="5"/>
              <text class="svg-chip-t" x="165" y="441" text-anchor="middle">Niveau 2</text>
