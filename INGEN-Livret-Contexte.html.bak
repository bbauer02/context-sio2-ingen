              <!-- Enclos -->
              <path class="svg-link-x" d="M834 402 V 470 M180 470 H 834"/>
              <text class="svg-e-x" x="846" y="440">fibre extérieure depuis le local technique du RdC</text>

              <rect class="svg-box-x" x="30" y="500" width="900" height="132" rx="4"/>
